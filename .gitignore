# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets.
# .env.example IS committed because it's the documented template (no real secrets).
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Agent skills (installed workflow pack)
/.agent-skills/

# Audit logs
/logs/

# --- P14-A: AI agent artifacts + build outputs (do NOT delete; gitignore only) ---
# AI junk files (agent worklogs, tool outputs, context docs, agent tooling dirs)
worklog.md
tool-results/
AGENTS.md
CONSTRAINTS.md
.cursor/
.zscripts/

# Build outputs (Next.js standalone export, tsbuildinfo, .next/cache explicit)
dist/
.next/cache
tsconfig.tsbuildinfo

# Process ID files
*.pid
dev.pid

# Note: *.log and dev.log are already covered above (lines 46-47) — not duplicated here.
