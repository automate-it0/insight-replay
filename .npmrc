# v11.18.6 SECURITY: prevent postinstall script attacks
# Blocks npm/bun from running package install scripts unless explicitly allowed
ignore-scripts=true
# Supply-chain hardening (defense-in-depth for any npm usage — this repo
# installs with bun): only resolve package versions published at least 7 days
# ago, so day-zero malicious or unstable releases cannot be installed.
# Key added in npm v11.10; the value is a number of DAYS.
# Ref: https://docs.npmjs.com/cli/using-npm/config#min-release-age
min-release-age=7
