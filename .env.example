# ───────────────────────────────────────────────────────────────────────────
# Insight Replay — environment variables example
# Copy this file to `.env` and fill in real values.
#
# Generate 32-byte hex secrets (256-bit entropy) with:
#   ./scripts/generate-secret.sh
#
# The startup module (src/lib/startup.ts) asserts every REQUIRED var is
# present on boot. Missing secrets fail fast — never silently insecure.
# ───────────────────────────────────────────────────────────────────────────


# ─── Database ───────────────────────────────────────────────────────────────
# SQLite file path. Prisma creates the file on first `db push`.
# Use an absolute path in production (e.g. /var/lib/insight-replay/custom.db).
DATABASE_URL="file:./db/custom.db"


# ─── Auth secrets (32-byte hex / 256-bit entropy) ───────────────────────────
# Generate with: ./scripts/generate-secret.sh
# REQUIRED in every environment. Rotate on every production deploy.
SESSION_SECRET="REPLACE_ME_WITH_64_HEX_CHARS_FROM_GENERATE_SECRET_SH"
ADMIN_TOKEN="REPLACE_ME_WITH_64_HEX_CHARS_FROM_GENERATE_SECRET_SH"


# ─── CORS allowlist (comma-separated, no spaces) ────────────────────────────
# Include the origin of every site you'll track + the dashboard origin itself.
# Examples:
#   Dev:    http://localhost:3000,http://localhost:81
#   Prod:   https://insight.example.com,https://shop.example.com
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:81"


# ─── Runtime mode ───────────────────────────────────────────────────────────
# development: loose CORS, no secure cookies, /api/seed open
# production:  strict CORS, secure cookies, origin validation on ingest, /api/seed disabled
NODE_ENV="development"


# ─── Optional: server bind ──────────────────────────────────────────────────
# PORT defaults to 3000; HOSTNAME defaults to 0.0.0.0 in Docker / localhost in dev.
# PORT=3000
# HOSTNAME=localhost


# ─── Optional: AI features (z-ai-web-dev-sdk) ───────────────────────────────
# If unset, AI features fail-open to a 200 with an `error` field.
# Set this to enable natural-language search, per-session analysis, and weekly project digests.
# ZAI_API_KEY=""


# ─── Optional: super-admin allowlist ────────────────────────────────────────
# Comma-separated user IDs allowed to be super-admins.
# Empty = any authenticated user (single-admin system).
# AUTHORIZED_SUPER_ADMINS=""


# ─── Optional: Next.js telemetry ────────────────────────────────────────────
# Set to 1 in production (the Dockerfile already does this).
# NEXT_TELEMETRY_DISABLED=1


# ───────────────────────────────────────────────────────────────────────────
# Security feature flags — all default ON in production.
# Set to the string "false" to disable. See src/lib/feature-flags.ts for the source of truth.
# ───────────────────────────────────────────────────────────────────────────

# Edge rate limiting (100 req/min/IP → 429 + Retry-After: 60)
# FF_RATE_LIMIT="true"

# CORS + origin validation on the ingest endpoint (ON in production)
# FF_CORS="true"

# Anonymize IP (zero last octet) before storage
# FF_IP_ANON="true"

# Audit logging on every mutation (/api/audit)
# FF_AUDIT="true"

# Socket.io live cursor broadcast
# FF_LIVE_TRACKING="true"

# LLM project-insights digest (requires ZAI_API_KEY)
# FF_AI_INSIGHTS="true"

# LLM per-session qualitative analysis (requires ZAI_API_KEY)
# FF_AI_SESSION="true"

# LLM natural-language search (requires ZAI_API_KEY)
# FF_AI_SEARCH="true"

# A/B experiments tab
# FF_EXPERIMENTS="true"

# Custom dashboards tab
# FF_DASHBOARDS="true"

# Verbose observability logging (opt-in)
# FF_DEBUG="false"
